    # Manifest des patterns Liang officiellement supportés.
    # Les 7 langues marquées `embedded: true` sont incluses dans
    # le binaire via la macro `read_file`. Les autres sont
    # installables via `asciidoctor-pdf hyph install <lang>` qui
    # télécharge depuis CTAN et vérifie le SHA-256 contre cette
    # table.
    #
    # Source : https://ctan.org/pkg/hyph-utf8
    # Licences : LPPL 1.3, MIT, GPL, LGPL et variantes selon le
    # fichier (chaque fichier déclare sa licence en en-tête).
    record ManifestEntry,
      lang : String,
      url : String,
      sha256 : String,
      size : Int32,
      license : String,
      embedded : Bool

    CTAN_PREFIX = "https://mirrors.ctan.org/language/hyph-utf8/tex/generic/hyph-utf8/patterns/tex/"

    # Metadata for a language excluded from MANIFEST for
    # licensing reasons. Carries the URL and the expected
    # SHA-256 just like `ManifestEntry`, so that a user who
    # accepts the licensing risk (via `hyph install --force`)
    # still gets the integrity check on download.
    record ExcludedEntry,
      reason : String,
      url : String,
      sha256 : String,
      size : Int32

    # Languages excluded from MANIFEST because their upstream
    # source file does not declare a free-software license.
    # Distributing them via this shard's manifest would put
    # downstream users in a legally ambiguous position. They
    # remain available from CTAN itself if the user explicitly
    # acknowledges the risk.
    #
    # The CLI consults this table BEFORE the manifest:
    #
    #   - `hyph install <lang>` without `--force` (or `-f`) is
    #     refused with the explanatory message stored here.
    #   - `hyph install <lang> --force` proceeds: a warning is
    #     printed on stderr, then download proceeds with
    #     SHA-256 verification using the hash stored here.
    #
    # `reason` is a diagnostic message in English (the lingua
    # franca of free-software licensing discussions).
