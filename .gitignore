# Binaires et artefacts de compilation Crystal
# Le source du CLI est désormais dans src/cli.cr : `shards build`
# produit un vrai binaire ELF dans bin/ sans rien écraser.
.crystal/
.shards/
/bin/*
*.dwarf

# Répertoire lib (dépendances installées par shards)
lib/

# Répertoire de sortie des tests
spec/output/

# Fichiers temporaires
*.tmp
*.bak
*~

# PDFs générés à partir des exemples (le source .adoc suffit ;
# l'utilisateur régénère le PDF avec `crystal-asciidoctor-pdf`)
examples/*.pdf
